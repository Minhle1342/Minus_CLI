{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run Minus CLI",
      "skipFiles": ["<node_internals>/**"],
      "runtimeArgs": [
        "--max-old-space-size=4096",
        "--import",
        "tsx"
      ],
      "args": ["src/index.ts"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"

    }
  ]
}
