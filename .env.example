# -----------------------------------------------------------------------------
# 1. Google Gemini API (Lấy miễn phí tại: https://aistudio.google.com/)
# Hỗ trợ: gemini-3.1-flash-lite-preview, gemini-3.5-flash, gemini-2.5-pro
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-3.1-flash-lite-preview

# -----------------------------------------------------------------------------
# 2. Groq Cloud API (Lấy miễn phí tại: https://console.groq.com/keys)
# Hỗ trợ Gemma 2 siêu tốc (>500 tokens/s): gemma2-9b-it
# -----------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# -----------------------------------------------------------------------------
# 3. DeepSeek API (Chuyên Coding)
# 
# Cách 1: Đăng ký tại https://platform.deepseek.com/ (Tặng sẵn 5M tokens miễn phí)
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-chat
#
# Cách 2: Dùng qua OpenRouter Free Tier (Lấy key tại https://openrouter.ai/)
# DEEPSEEK_API_KEY=sk-or-v1-...
# DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
# MODEL_NAME=openrouter/free
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# -----------------------------------------------------------------------------
# 4. Cấu hình Workspace & Vòng lặp Agent
# -----------------------------------------------------------------------------
MAX_STEPS=30
# Đường dẫn thư mục làm việc của Agent (nếu để trống sẽ tự động lấy thư mục hiện tại)
WORKSPACE_PATH=
