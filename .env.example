# =============================================================================
# CẤU HÌNH API KEYS CHO CÁC NHÀ CUNG CẤP MIỄN PHÍ (FREE TIER)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Google Gemini API (Lấy miễn phí tại: https://aistudio.google.com/)
# Free Tier: 1.500 requests/ngày, context 1M tokens, không cần thẻ tín dụng
# Models: gemini-3.7-flash, gemini-3.6-flash, gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite-preview, gemini-3.1-flash-lite, gemini-flash-latest
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-3.7-flash

# -----------------------------------------------------------------------------
# 2. Groq Cloud API (Lấy miễn phí tại: https://console.groq.com/keys)
# Free Tier: LPU siêu tốc > 500 tokens/s, 14.400 requests/ngày
# Models: groq/llama-3.3-70b-versatile, groq/deepseek-r1-distill-llama-70b, groq/llama-3.1-8b-instant, groq/gemma2-9b-it
# -----------------------------------------------------------------------------
GROQ_API_KEY=

# -----------------------------------------------------------------------------
# 3. Cerebras Cloud API (Lấy miễn phí tại: https://cloud.cerebras.ai/)
# Free Tier: Tốc độ kỷ lục thế giới ~1.800 tokens/s, 1.000.000 tokens/ngày
# Models: cerebras/llama-3.3-70b, cerebras/llama3.1-8b
# -----------------------------------------------------------------------------
CEREBRAS_API_KEY=

# -----------------------------------------------------------------------------
# 4. SambaNova Cloud API (Lấy miễn phí tại: https://cloud.sambanova.ai/)
# Free Tier: Hỗ trợ model Llama 405B khổng lồ chạy miễn phí
# Models: sambanova/Meta-Llama-3.1-405B-Instruct, sambanova/Meta-Llama-3.3-70b-Instruct
# -----------------------------------------------------------------------------
SAMBANOVA_API_KEY=

# -----------------------------------------------------------------------------
# 5. GitHub Models (Tạo token tại: https://github.com/settings/tokens)
# Free Tier: Dùng GitHub Personal Access Token (classic hoặc fine-grained)
# Models: github/gpt-4o, github/gpt-4o-mini, github/Mistral-large-2407
# -----------------------------------------------------------------------------
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# 6. SiliconFlow (Lấy key tại: https://siliconflow.cn/)
# Free Tier: Tặng sẵn token khi đăng ký + nhiều model Open-source miễn phí
# Models: siliconflow/deepseek-ai/DeepSeek-V3, siliconflow/Qwen/Qwen2.5-Coder-32B-Instruct
# -----------------------------------------------------------------------------
SILICONFLOW_API_KEY=

# -----------------------------------------------------------------------------
# 7. Mistral AI (Lấy key tại: https://console.mistral.ai/)
# Free Tier: Cấp gói Codestral chuyên lập trình miễn phí cho lập trình viên
# Models: mistral/codestral-latest, mistral/mistral-large-latest
# -----------------------------------------------------------------------------
MISTRAL_API_KEY=

# -----------------------------------------------------------------------------
# 8. OpenRouter (Lấy key tại: https://openrouter.ai/keys)
# Free Tier: Gom 20+ model miễn phí có đuôi :free hoặc auto router
# Models: openrouter/free, openrouter/meta-llama/llama-3.3-70b-instruct:free, openrouter/deepseek/deepseek-r1:free
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# 9. DeepSeek Direct (Lấy key tại: https://platform.deepseek.com/)
# Models: deepseek-chat (V3), deepseek-reasoner (R1)
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=

# -----------------------------------------------------------------------------
# 10. 9Router Local AI Gateway (Chạy: npm run 9router)
# Endpoint mặc định: http://localhost:20128/v1
# -----------------------------------------------------------------------------
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_API_KEY=123456

# -----------------------------------------------------------------------------
# 11. Cấu hình Vòng lặp Agent & Workspace
# -----------------------------------------------------------------------------
MAX_STEPS=30
WORKSPACE_PATH=
