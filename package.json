{
  "name": "mini-agent-loop",
  "version": "1.0.0",
  "description": "Minimal AI Agent Loop in TypeScript + Node.js with Gemini API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "predev": "npm run search:up",
    "dev": "tsx src/index.ts",
    "test": "tsx src/test-suite.ts",
    "test:scenarios": "tsx src/test-scenarios.ts",
    "build": "tsc",
    "search:up": "docker compose -f deploy/searxng/compose.yaml up -d",
    "search:down": "docker compose -f deploy/searxng/compose.yaml down",
    "9router": "node scripts/start-9router.js",
    "start": "node dist/index.js"
  },
  "keywords": [
    "ai-agent",
    "agent-loop",
    "gemini",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.18.0",
    "dotenv": "^16.4.7",
    "minisearch": "^7.2.0",
    "repomix": "^1.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
