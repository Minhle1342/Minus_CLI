{
  "name": "mini-agent-loop",
  "version": "1.0.0",
  "description": "Minimal AI Agent Loop in TypeScript + Node.js with Gemini API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "predev": "npm run search:up",
    "dev": "node --max-old-space-size=4096 --import tsx src/index.ts",
    "test": "node --max-old-space-size=4096 --import tsx src/test-suite.ts",
    "test:completion": "node --import tsx --test src/agent/completion-policy.test.ts",
    "test:ocr": "node --import tsx --test src/review/open-code-review.test.ts",
    "test:scenarios": "tsx src/test-scenarios.ts",
    "test:latency": "tsx src/test-latency-optimization.ts",
    "test:compaction": "node --import tsx --test src/agent/context-budget-manager.test.ts",
    "test:native-io": "node --import tsx --test src/native/index.test.ts src/sandbox/local-sandbox.test.ts",
    "test:compaction-pareto": "node --import tsx --test src/eval/compaction-pareto.test.ts",
    "test:prompt-gating": "node --import tsx --test src/agent/step-prompt-policy.test.ts src/agent/step-prompt-policy.integration.test.ts",
    "test:pareto": "node --import tsx --test src/agent/pareto-evidence-policy.test.ts",
    "test:context-retrieval": "node --import tsx --test src/search/context-retrieval.test.ts src/agent/reliable-tool-orchestration.test.ts src/agent/reliable-tool-orchestration.integration.test.ts",
    "test:blast-radius": "tsx src/test-blast-radius.ts",
    "benchmark:context": "tsx src/eval/context-retrieval-benchmark.ts",
    "benchmark:compaction": "tsx src/eval/compaction-benchmark.ts",
    "benchmark:compaction:gate": "tsx src/eval/compaction-benchmark.ts --repeats=18 --require-conclusive",
    "benchmark:code-context": "tsx src/eval/code-context-retrieval-benchmark.ts",
    "benchmark:prompt-gating:live": "tsx src/eval/prompt-gating-live-benchmark.ts",
    "benchmark:native-io": "tsx scripts/benchmark-native-io.ts",
    "build": "tsc",
    "native:build": "node scripts/build-native.js",
    "search:up": "tsx src/scripts/start-searxng.ts",
    "search:down": "docker compose --file deploy/searxng/compose.yaml down",
    "sandbox:build": "docker build -t minus-sandbox:latest -f deploy/sandbox/Dockerfile .",
    "eval": "tsx src/eval/cli.ts",
    "eval:mock": "tsx src/eval/cli.ts --mock",
    "9router": "node scripts/start-9router.js",
    "start": "node --max-old-space-size=4096 dist/index.js"
  },
  "keywords": [
    "ai-agent",
    "agent-loop",
    "gemini",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@alibaba-group/open-code-review": "1.12.5",
    "@google/genai": "^2.18.0",
    "adm-zip": "^0.6.1",
    "diff": "^9.0.0",
    "dotenv": "^16.4.7",
    "fast-glob": "^3.3.3",
    "fast-xml-parser": "^5.11.1",
    "fs-extra": "^11.4.1",
    "glob": "^13.0.6",
    "ink": "^7.1.1",
    "json5": "^2.2.3",
    "minimatch": "^10.2.6",
    "minisearch": "^7.2.0",
    "prettier": "^3.9.9",
    "react": "^19.2.8",
    "repomix": "^1.18.0",
    "ts-morph": "^28.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/diff": "^7.0.2",
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^8.1.0",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.18",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "optionalDependencies": {
    "hnswlib-node": "^3.0.0"
  }
}
